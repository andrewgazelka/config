# Command-position abbreviations, expanded on space/enter (see config.nu).
{
    "..": "up"
    "al": "aerospace list-windows --workspace focused --json | from json"
    "b": "bat"
    "bc": "bacon clippy"
    "bd": "bun dev"
    "bi": "bun install"
    "bri": "brew install"
    "brl": "bun run lint"
    "bs": "brew search"
    "bt": "btop"
    "ca": "cat"
    "cad": "cargo add"
    "cb": "cargo build"
    "cbb": "cargo build --release"
    "cbi": "cargo binstall -y"
    "cbp": "cargo build -p"
    "ccl": "cargo clean"
    "cdo": "cargo doc --open"
    "cdp": "^open -na 'Google Chrome' --args --remote-debugging-port=9222 --user-data-dir=($env.HOME)/chrome-cdp-profile"
    "ce": "cargo run --example"
    "cF": "cargo fetch"
    "cf": "cargo fmt"
    "cft": "cloudflared tunnel --url http://localhost:8000"
    "ci": "cargo install"
    "cid": "cargo install --debug --locked --path"
    "cig": "cargo install --git"
    "cip": "cargo install --locked --path"
    "cl": "claude --dangerously-skip-permissions"
    "cld": "claude --debug"
    "clh": "claude --model=haiku --dangerously-skip-permissions"
    "cll": "claude --dangerously-skip-permissions --model=claude-opus-4-7 --effort xhigh"
    "clp": "cargo clippy --all-targets  --timings -Zbuild-analysis"
    "clpf": "cargo clippy --fix --all-targets --allow-dirty --allow-staged"
    "clr": "claude --dangerously-skip-permissions --resume"
    "cls": "claude --dangerously-skip-permissions --model=sonnet"
    "clt": "claude --teleport"
    "cm": "cargo metadata --format-version=1 | from json"
    "cmn": "cargo metadata --no-deps --format-version=1 | from json"
    "cnl": "cargo new --lib"
    "co": "codex --yolo"
    "cod": "pnpx @openai/codex --yolo"
    "col": "columns"
    "com": "complete"
    "cone": "config env"
    "conn": "config nu"
    "cor": "codex --yolo resume"
    "cpp": "realpath . | pbcopy"
    "cpu": "ps -l | sort-by cpu"
    "cr": "cargo run"
    "cre": "cargo run --example"
    "crp": "cargo run -p"
    "crr": "cargo run --release"
    "cs": "cargo search"
    "ct": "cargo nextest run"
    "cti": "cargo tree -i"
    "ctr": "cargo tree"
    "ctt": "cargo nextest run --release"
    "cx": "chmod +x"
    "db": "docker build ."
    "dbp": "docker build --platform linux/amd64 ."
    "dc": "detect columns --guess"
    "dcd": "docker compose down"
    "dcu": "docker compose up --build --watch"
    "dl": "c ~/Downloads"
    "dps": "docker ps"
    "dr": "nh darwin switch"
    "drb": "nh darwin build"
    "dy": "bat -l yaml --style=plain"
    "e": "explore -ip | to json -r "
    "et": "eza --tree --icons=auto --git --git-ignore"
    "ez": "eza --icons=auto --group-directories-first"
    "f": "fd -H"
    "f1": "first"
    "f2": "first 2"
    "f3": "first 3"
    "f4": "first 4"
    "f5": "first 5"
    "f6": "first 6"
    "f7": "first 7"
    "f8": "first 8"
    "f9": "first 9"
    "fj": "from json"
    "fjo": "from json -o"
    "fs": "from ssv"
    "ft": "from tsv"
    "ga": "git add"
    "ga.": "git add ."
    "gan": "git add -N"
    "gan.": "git add -N ."
    "gap": "git add -p"
    "gb": "git branch"
    "gba": "git branch -a"
    "gbm": "git blame $'(git_default_branch)' --"
    "gbr": "gh browse"
    "gc": "git commit"
    "gca": "git commit --amend"
    "gcl": "git clone"
    "gclb": "git clone --bare"
    "gcn": "git commit --no-verify"
    "gco": "git checkout"
    "gco.": "git checkout ."
    "gcom": "git checkout main --"
    "gcp": "git add . ; git commit ; git push"
    "gcs": "git commit --amend --no-edit -S"
    "gd": "git diff"
    "gdh": "git diff HEAD"
    "gdm": "git diff $'origin/(git_default_branch)...'"
    "gdm-": "git diff $'origin/(git_default_branch)...' --"
    "gdms": "git diff $'origin/(git_default_branch)...' --stat"
    "gds": "git diff --staged"
    "gdss": "git diff --staged --stat"
    "gdt": "git difftool"
    "gf": "gh repo fork"
    "gfa": "git fetch --all --prune"
    "ggl": "gsutil ls"
    "gha": "git rev-parse --short HEAD | pbcopy"
    "ghe": "git rev-parse HEAD"
    "gii": "gh issue create -e"
    "gil": "gh issue list --author @me"
    "gl": "git log --oneline"
    "gl1": "git log -1"
    "gl2": "git log -2"
    "gla": "git log --author='Andrew Gazelka'"
    "glg": "git lg --grep"
    "glm": "git lg $'(git_default_branch)...'"
    "glo": "git log --oneline"
    "glp": "git log -p --ext-diff --"
    "gls": "git log --stat --"
    "gmm": "git fetch --all; git merge $'origin/(git_default_branch)'"
    "gp": "git push"
    "gpf": "git push --force-with-lease"
    "gpl": "git pull"
    "gpm": "gh pr merge --auto --merge"
    "gpp": "git push -u origin HEAD"
    "gpr": "gh pr view -w"
    "gprl": "gh pr list --author @me"
    "gpro": "gh pr create -w"
    "gprw": "gh pr view -w"
    "grb": "git rebase"
    "grc": "git rebase --continue"
    "gri": "git rebase -i --rebase-merges"
    "grm": "git fetch --all; git rebase $'origin/(git_default_branch)'"
    "gro": "c (git rev-parse --show-toplevel)"
    "grom": "git rebase --onto main"
    "grs": "git reset --soft"
    "gs": "git status"
    "gsa": "git stash"
    "gsd": "git stash drop"
    "gsho": "git show --ext-diff"
    "gshos": "git show --stat"
    "gsmi": "git submodule init"
    "gsms": "git submodule status"
    "gsmu": "git submodule update"
    "gsmui": "git submodule update --init"
    "gsmuir": "git submodule update --init --recursive"
    "gsp": "git stash pop"
    "gwa": "git worktree add"
    "gwc": "git switch -c"
    "gwl": "git worktree list"
    "gwm": "gw main"
    "gwp": "git switch -"
    "hg": "http get --content-type=application/json"
    "hj": "http --content-type=json"
    "hp": "http post -e --full --content-type=application/json"
    "ht": "http"
    "k": "kill"
    "l": "eza --icons=auto --group-directories-first"
    "l1": "last"
    "l2": "last 2"
    "l3": "last 3"
    "l4": "last 4"
    "l5": "last 5"
    "l6": "last 6"
    "l7": "last 7"
    "l8": "last 8"
    "l9": "last 9"
    "le": "length"
    "ll": "eza --icons=auto -a --group-directories-first -l --sort time"
    "lo": "lsof -i :"
    "lso": "ls | sort-by modified"
    "lt": "eza --icons=auto --sort=newest"
    "n": "nom"
    "nb": "nom build"
    "nd": "nom develop"
    "ne": "nix eval --json"
    "nfm": "nix flake metadata --json  | from json"
    "nr": "nix run"
    "ns": "nix search nixpkgs"
    "o": "open"
    "oo": "open ."
    "op": "open"
    "p": "pwd"
    "pa": "plugin add"
    "pci": "pre-commit install"
    "pk": "pkill -9"
    "pl": "git pull"
    "pr": "c ~/Projects"
    "psr": "ps -l | where status == \"Running\""
    "pt": "ptree"
    "pu": "pulumi"
    "pud": "pulumi down --yes"
    "puu": "pulumi up --yes"
    "px": "pnpx"
    "R": "cargo run"
    "r": "rg --hidden"
    "rf": "rm -rf"
    "rj": "reject"
    "rl": "nix-direnv-reload"
    "rp": "realpath"
    "rr": "rustrover"
    "rr.": "rustrover ."
    "s": "ssh"
    "sb": "sort-by"
    "se": "select"
    "sor": "sort-by -r"
    "sqlp": "SQLX_OFFLINE=false cargo sqlx prepare -- --all-features --tests --all-targets"
    "sqlr": "cargo sqlx database reset -y"
    "st": "strings"
    "su": "git submodule update"
    "t": "trash"
    "ta": "tmux attach -t"
    "tj": "to json"
    "tjr": "to json -r"
    "tk": "tmux kill-session -t"
    "tn": "to nuon"
    "ty": "to yaml"
    "u": "uniq -c"
    "ua": "uv add"
    "uenv": "uv venv"
    "ul": "uv pip list"
    "us": "uv sync --all-packages"
    "v": "vim"
    "w": "where"
    "wa": "which -a"
    "wg": "wget"
    "wn": "where name"
    "z": "pbcopy"
    "zi": "zoxide query -i"
    "zz": "git add . ; git commit -m z; git push"
}
